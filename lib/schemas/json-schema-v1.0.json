{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tea-platform.org/schemas/case-export-v1.0.json",
  "title": "TEA Platform Assurance Case Export Schema v1.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version identifier"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp of export"
    },
    "case": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the assurance case"
        },
        "description": {
          "type": "string",
          "description": "Description of the assurance case"
        }
      },
      "required": ["name", "description"],
      "additionalProperties": false,
      "description": "Case metadata"
    },
    "tree": {
      "description": "Root element of the case tree",
      "allOf": [
        {
          "$ref": "#/definitions/TreeNode"
        }
      ]
    }
  },
  "required": ["version", "exportedAt", "case", "tree"],
  "additionalProperties": false,
  "description": "Assurance case export in nested tree format (v1.0)",
  "definitions": {
    "TreeNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "type": {
          "type": "string",
          "enum": [
            "GOAL",
            "CONTEXT",
            "STRATEGY",
            "PROPERTY_CLAIM",
            "EVIDENCE",
            "JUSTIFICATION",
            "ASSUMPTION",
            "MODULE",
            "AWAY_GOAL",
            "CONTRACT"
          ],
          "description": "The type of element in an assurance case"
        },
        "name": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string"
        },
        "inSandbox": {
          "default": false,
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/TreeNode"
              }
            ]
          }
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["TOP_LEVEL", "SUPPORTING"],
              "description": "The role of an element - TOP_LEVEL for root goals, SUPPORTING for child elements"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumption": {
          "type": ["string", "null"]
        },
        "justification": {
          "type": ["string", "null"]
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": ["string", "null"]
        },
        "level": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "moduleReferenceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "moduleEmbedType": {
          "type": "string",
          "enum": ["COPY", "REFERENCE"],
          "description": "How a module is embedded - COPY creates independent copy, REFERENCE links to original"
        },
        "modulePublicSummary": {
          "type": ["string", "null"]
        },
        "citedElementId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fromPattern": {
          "default": false,
          "type": "boolean"
        },
        "modifiedFromPattern": {
          "default": false,
          "type": "boolean"
        },
        "isDefeater": {
          "type": "boolean"
        },
        "defeatsElementId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "assertionStatus": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ASSERTED",
                "NEEDS_SUPPORT",
                "ASSUMED",
                "AXIOMATIC",
                "DEFEATED",
                "AS_CITED"
              ],
              "description": "Per-assertion status of an element (SACM §11.8); unset is treated as ASSERTED"
            },
            {
              "type": "null"
            }
          ]
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "author": {
                "type": "string",
                "description": "Username of the comment author"
              },
              "content": {
                "type": "string",
                "description": "Comment text content"
              },
              "createdAt": {
                "type": "string",
                "description": "ISO 8601 timestamp of comment creation"
              }
            },
            "required": ["author", "content", "createdAt"],
            "additionalProperties": false,
            "description": "A comment attached to an element"
          }
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "description",
        "inSandbox",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
