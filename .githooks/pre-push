#!/usr/bin/env bash
# Pre-push gate: regenerates the Prisma client, then runs lint and typecheck
# on every push. CI remains the authoritative gate and also runs the test
# suite. A push that only deletes branches (all-zero local sha on every ref)
# is let through without running checks.
set -u

zero=0000000000000000000000000000000000000000
any_non_delete=false

# git feeds us: <local_ref> <local_sha> <remote_ref> <remote_sha> per line
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # branch deletion — let it through
  any_non_delete=true
done

[[ "$any_non_delete" == "true" ]] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

before_dirty="$(git diff --name-only)"

echo "[pre-push] Regenerating Prisma client..."
# A placeholder DATABASE_URL is enough: generation reads the schema and does
# not connect to a database, so this does not require Postgres to be running.
if ! DATABASE_URL="postgresql://prepush:prepush@localhost:5432/prepush" pnpm exec prisma generate --schema=prisma/schema.prisma; then
  echo "[pre-push] ✗ prisma generate failed" >&2
  echo "[pre-push] Blocked: fix the errors above before pushing." >&2
  echo "[pre-push] (Emergency bypass: git push --no-verify — CI will still gate.)" >&2
  exit 1
fi

after_dirty="$(git diff --name-only)"
newly_dirty="$(comm -13 \
  <(printf '%s\n' "$before_dirty" | grep -v '^$' | sort -u) \
  <(printf '%s\n' "$after_dirty" | grep -v '^$' | sort -u))"

if [[ -n "$newly_dirty" ]]; then
  echo "[pre-push] ✗ prisma generate changed tracked file(s) that were not already modified:" >&2
  echo "$newly_dirty" | sed 's/^/[pre-push]     /' >&2
  echo "[pre-push] Commit the regenerated file(s) and push again." >&2
  echo "[pre-push] Blocked: fix the errors above before pushing." >&2
  echo "[pre-push] (Emergency bypass: git push --no-verify — CI will still gate.)" >&2
  exit 1
fi

echo "[pre-push] Running lint + typecheck..."
fail=0
if ! pnpm lint; then
  echo "[pre-push] ✗ lint failed" >&2
  fail=1
fi
if ! pnpm typecheck; then
  echo "[pre-push] ✗ typecheck failed" >&2
  fail=1
fi

if [[ $fail -ne 0 ]]; then
  echo "[pre-push] Blocked: fix the errors above before pushing." >&2
  echo "[pre-push] (Emergency bypass: git push --no-verify — CI will still gate.)" >&2
  exit 1
fi
echo "[pre-push] ✓ all checks passed"
exit 0
