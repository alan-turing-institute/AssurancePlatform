  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --config vitest.workspace.ts --project unit",
    "test:fast": "vitest run --config vitest.workspace.ts --project unit --reporter=dot",
    "test:coverage": "COVERAGE=true vitest --coverage",
    "test:coverage:check": "COVERAGE=true vitest run --coverage",
    "test:quick": "vitest --run --reporter=dot",
    "test:integration": "vitest run --config vitest.workspace.ts --project integration",
    "test:integration:watch": "vitest --config vitest.workspace.ts --project integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "docs:generate": "next-openapi-gen generate",
    "schema:generate": "tsx scripts/generate-json-schema.ts",
    "typecheck": "tsc --noEmit"
  },
