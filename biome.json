{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "app/**",
      "components/**",
      "hooks/**",
      "lib/**",
      "providers/**",
      "actions/**",
      "types/**",
      "config/**",
      "src/**",
      "*.js",
      "*.jsx",
      "*.ts",
      "*.tsx",
      "*.json",
      "*.mjs",
      "!**/*.min.js",
      "!**/node_modules",
      "!**/.next",
      "!**/src/generated",
      "!**/public/documentation",
      "!types/*.d.ts",
      "!app/api/cases/*/permissions",
      "!components/ui",
      "!components/ai-elements",
      "!lib/plugins/assistant/linter/ruleset-data.ts",
      "!lib/plugins/assistant/linter/judgement-prompt.ts",
      "!prisma/scripts",
      "!prisma/seed/fixtures",
      "!.pnpm-store",
      "!TASKS",
      "!.claude",
      "!**/.claude",
      "!.beads",
      "!**/.beads",
      "!.patches",
      "!tea-docs",
      "!*.openapi.json",
      "!public/openapi.json",
      "!.fallow-baseline.*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "noIncrementDecrement": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 500, "skipBlankLines": true }
        }
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "suspicious": {
        "noConsole": "error",
        "noUnknownAtRules": "off"
      }
    }
  },
  "css": {
    "linter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 1500, "skipBlankLines": true }
            }
          },
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["lib/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "prisma/seed/**", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**"],
